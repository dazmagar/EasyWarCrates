package-as: EasyWarCrates

# Use the written changelog, not one generated from the log.
#
# Without this the packager summarises every commit since the previous tag, and
# on a first release that is the whole history -- 106 of them, each an essay,
# which came to more than the 125,000 characters GitHub accepts in a release
# body. CurseForge and Wago took the upload and the GitHub release failed.
#
# The log is written for whoever maintains this. A release note is written for
# whoever is deciding whether to install it, and they are not the same document.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

# What the packager must leave out of the published addon. Everything here is
# how the addon is built and reasoned about, not part of what the game loads:
# tools/ deploys to one particular machine, tests/ and research/ never ship,
# and tmp/ holds working notes.
#
# assets/ is the screenshots for the listing page, which belong on the page and
# not inside the download. dist/ is the archive this repo builds for itself.
#
# tools/deploy.py enforces the same thing from the other end -- it copies the
# .toc and exactly the files it lists -- so the deployed folder and the
# published zip agree by construction rather than by two lists being kept in
# step by hand. tools/package.py then reads its own archive back and refuses
# any of these, so a name missed here is still caught before anything is
# uploaded.
ignore:
    - tools
    - tests
    - research
    - tmp
    - .venv
    - dist
    - assets
    - .github
    - .gitattributes
    - .gitignore
    - .pkgmeta
    - README.md
