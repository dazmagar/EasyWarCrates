# Not ours. Vendored rather than fetched at build time, and why each one is
# needed is in Libs/README.md. Load order is a dependency chain: LibDBIcon
# needs LibDataBroker, both need CallbackHandler, and all three find each other
# through LibStub. These are the only files here that do not load under a plain
# Lua interpreter -- LibDBIcon builds a frame at load -- so tests/run.py works
# from its own list of our files and never reads this section.
Libs/LibStub/LibStub.lua
Libs/CallbackHandler-1.0/CallbackHandler-1.0.lua
Libs/LibDataBroker-1.1/LibDataBroker-1.1.lua
Libs/LibDBIcon-1.0/LibDBIcon-1.0.lua

# Data and logic. Everything down to Track/Timers.lua loads under a plain Lua
# interpreter as well: the WoW calls these make are injected or sit inside
# function bodies, never at load. tests/run.py loads this same set, in order.
Core/Init.lua
Data/Zones.lua
Data/DropPoints.lua
Data/Vignettes.lua
Data/Announcers.lua
Core/Zones.lua
Detect/Shard.lua
Detect/Heading.lua
Detect/Predict.lua
Track/Timers.lua
Track/Learn.lua
Track/Route.lua
Track/Remote.lua
Track/Phase.lua
Track/Airtime.lua
UI/Model.lua
UI/Manage.lua

# Below here the files create frames and register events at load, so they only
# run in game. Kept deliberately thin -- they move numbers between the game and
# the modules above, and hold no logic of their own.
Detect/Scanner.lua
Core/Main.lua
Core/Comm.lua
Core/Commands.lua
UI/Window.lua
UI/Minimap.lua
UI/DataPanel.lua
UI/Settings.lua
