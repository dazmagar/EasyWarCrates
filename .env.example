# Copy to .env and fill in. .env is ignored by git and refused by the test
# suite, which checks every tracked file for anything token-shaped.
#
# This file is only for releasing from this machine with the BigWigs
# release.sh. The GitHub Actions workflow cannot read it -- it runs on
# GitHub's servers and reads repository secrets of the same names:
#
#   https://github.com/dazmagar/EasyWarCrates/settings/secrets/actions
#
# A token pasted into a public repository has to be revoked and reissued, and
# everyone who cloned in between still has it. Keep it in one place you control.

CF_API_KEY=
WAGO_API_TOKEN=
